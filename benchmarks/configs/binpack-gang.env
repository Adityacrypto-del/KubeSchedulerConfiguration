# c. binpack-gang: b plus GenericWorkload (Workload and PodGroup APIs and the
# GangScheduling plugin). Multi-Pod jobs get a Workload and a PodGroup with
# gang minCount equal to their Pod count.
SCHEDULER_CONFIG=scheduler-config.yaml
FEATURE_GATES=GenericWorkload=true
RUNTIME_CONFIG=scheduling.k8s.io/v1beta1=true
WORKLOAD_MODE=gang
