# d. binpack-gang-topology: c plus TopologyAwareWorkloadScheduling. PodGroups
# also carry schedulingConstraints.topology with key topology.rack, so each
# multi-Pod job must fit within one rack.
SCHEDULER_CONFIG=scheduler-config.yaml
FEATURE_GATES=GenericWorkload=true,TopologyAwareWorkloadScheduling=true
RUNTIME_CONFIG=scheduling.k8s.io/v1beta1=true
WORKLOAD_MODE=gang-topology
